[Desktop Entry]
Type=Application
Name=Desktop
Comment=Plasma desktop across several VR screens (Frametop)
Exec=@SESSION@
Categories=Utility;
# Not in Plasma's own menus: in Frametop it only finds itself already running. Steam's launcher
# runs with XDG_CURRENT_DESKTOP=gamescope, so it still lists it.
NotShowIn=KDE;

# Installed by desktops.sh install into ~/.local/share/applications,
# where it overrides /usr/share/applications/deckard-nested-desktop.desktop.
# Remove it with desktops.sh uninstall to get the stock desktop back.
Icon=desktop
X-Steam-Library-Capsule=/usr/share/applications/steam/steamos-nested-desktop/capsule.png
X-Steam-Library-Hero=/usr/share/applications/steam/steamos-nested-desktop/hero.png
X-Steam-Library-Logo=/usr/share/applications/steam/steamos-nested-desktop/logo.png
X-Steam-Library-StoreCapsule=/usr/share/applications/steam/steamos-nested-desktop/store-logo.png
X-Steam-Controller-Template=Desktop
X-Steam-Special=Desktop
