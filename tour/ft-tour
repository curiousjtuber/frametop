#!/bin/bash
# Frametop Tour: what Frametop does, a page at a time (ft_tour.py and main.qml, in Frametop's
# Python runtime like Frametop Input Settings: scripts/ft-python, pack/flatpak).
#   ft-tour              open the tour (FT_TOUR_PAGE=ID opens it on that page)
#   ft-tour --first-run  open it only if it hasn't been closed, skipped, or finished yet (the
#                        Frametop desktop's autostart)
#   ft-tour --reset      open it at the desktop's next start again
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
case ${1:-} in
  --first-run) /usr/bin/python3 -I "$here/ft_tour.py" done && exit 0; shift ;;
  --reset) exec /usr/bin/python3 -I "$here/ft_tour.py" reset ;;
  "") ;;
  *) echo "usage: $0 [--first-run|--reset]" >&2; exit 2; ;;
esac
exec "$here/../scripts/ft-python" --gui "$here/ft_tour.py"
