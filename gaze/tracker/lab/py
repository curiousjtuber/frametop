#!/usr/bin/env bash
# Python with numpy and OpenCV for the lab tools. On the Frame: Frametop's Python runtime
# (scripts/ft-python, the Flatpak). Elsewhere (a PC, frame-job): gaze/tracker/build/venv,
# which frame-job's SETUP makes.
# Usage: lab/py lab/TOOL [args]   (from gaze/tracker)
here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if grep -qx 'ID=steamos' /etc/os-release 2>/dev/null; then
  exec "$here/../../scripts/ft-python" "$@"
fi
py=$here/build/venv/bin/python
[ -x "$py" ] || { echo "no $py: a frame-job job's setup makes it" >&2; exit 1; }
exec "$py" "$@"
