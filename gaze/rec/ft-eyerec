#!/bin/bash
# Launch the Frametop Eye Recorder from a Plasma session on the Frame host (its app menu entry,
# gaze/rec/install.sh). The app runs in Frametop's Python runtime, a Flatpak (scripts/ft-python,
# pack/flatpak; PySide6, zstd, cryptography and huggingface_hub are in it), as the package
# gaze.rec of the tree; --gui hands it the session's Wayland socket and bus.
# Options go to ft_eyerec.py: --base DIR, --page NAME, and --dry-run (--hub-dry-run, --ignore-eyes) for testing.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
exec "$here/../../scripts/ft-python" --gui -m gaze.rec.ft_eyerec "$@"
