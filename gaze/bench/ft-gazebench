#!/bin/bash
# Launch the Frametop Gaze Bench from a Plasma session on the Frame host (its app menu entry,
# gaze/bench/install.sh), as the eye recorder's gaze/rec/ft-eyerec: the app runs in Frametop's
# Python runtime (PySide6; scripts/ft-python, pack/flatpak), on the session's Wayland socket
# and bus. FT_GAZE and FT_BENCH_BASE pass through.
# Options go to gazebench.py: --base DIR (where runs go), --no-images, --no-button.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
exec "$here/../../scripts/ft-python" --gui "$here/gazebench.py" "$@"
