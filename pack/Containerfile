# Frametop's build image (pack/host-and-flatpak.md, pack/README.md).
#
# One image that builds Frametop's programs for the SteamOS host, with the same build.sh
# scripts a developer runs on the Frame, and holds the test gate's Python. Its glibc (2.43)
# is a SteamOS beta's and its gcc (16) newer still, both past the oldest SteamOS a release
# runs on: scripts/host-glibc.sh keeps every program within that floor (the symbol-version
# pins in scripts/glibc-compat.h) and checks it after each link, so what links here starts
# there.
# CI builds the image, runs the test gate in it, and copies the built tree out for the release
# (.github/workflows/release.yml); `ft dev shell` is the same environment for a developer.
# Nothing from here runs on the headset as a container.
#
# The Fedora packages come from setup/packages.txt, one list for this image and the Frame's
# "dev" container (setup/dev-container.sh, Remote Access's), which also starts from the base
# digest below: the lines marked "both" and "image" here, with why each one is there.
FROM registry.fedoraproject.org/fedora-toolbox:44@sha256:034cb7c472038e2d879ddc19568106a1342aa24403f0d641a0f73dda638707ad AS runtime-common

# Toolchain and the libraries the programs link (the host has the same ones, older or the
# same): the "both" and "image" lines of setup/packages.txt.
COPY setup/packages.txt /tmp/packages.txt
RUN dnf -y install --setopt=install_weak_deps=False \
      $(sed -nE 's/#.*//; s/^(both|image):(.*)/\2/p' /tmp/packages.txt) \
    && dnf -y remove 'glibc-langpack-*' \
    && dnf -y install glibc-langpack-en \
    && dnf clean all \
    && rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* \
              /usr/share/wallpapers /tmp/packages.txt

# OpenVR's API library for linking, from the SDK commit the build scripts pin
# (v2.15.6; scripts/openvr.sh fetches the headers). The image has no SteamVR, so the
# binaries link this copy; their rpath names SteamVR's folder first, so on the
# Frame they load SteamVR's own libopenvr_api, as the on-device builds do.
RUN install -d /opt/frametop/lib \
 && curl -fsSL https://github.com/ValveSoftware/openvr/raw/0924064316de3effbcd1acf1e309182a2deb1c05/bin/linuxarm64/libopenvr_api.so \
      -o /opt/frametop/lib/libopenvr_api.so \
 && echo "cc3671d24dd23fb61494e8a8327cf4fe7f638a60508ff7225984a03f2f5947e9  /opt/frametop/lib/libopenvr_api.so" | sha256sum -c

# The test gate's Python: Fedora's own python3 (the digest-pinned base freezes it), with the
# locked packages in a venv on top: the dev group (pytest, ruff), the tracker group (numpy,
# OpenCV, ncnn, huggingface_hub, cryptography) and the voice group (sherpa-onnx). The Frame's
# Python runtime is the Flatpak (pack/flatpak), from the same lock; this venv only tests.
# Rebuilt only when the lockfile changes, so source edits below reuse this layer.
# --no-cache keeps uv's download cache out of the image. uv is a pinned, checked build
# tool, not a runtime dependency: extracted, used, and removed in one layer.
ENV UV_PROJECT_ENVIRONMENT=/opt/frametop/venv UV_PYTHON=/usr/bin/python3 UV_PYTHON_DOWNLOADS=never
COPY pyproject.toml uv.lock .python-version /src/frametop/
RUN uvdir=$(mktemp -d) \
 && curl -fsSL https://github.com/astral-sh/uv/releases/download/0.12.23/uv-aarch64-unknown-linux-gnu.tar.gz \
      -o "$uvdir/uv.tar.gz" \
 && echo "6524bd338177ed50d035d39354e12545e993bbeba2ecbddf0480c5b3a81d313f  $uvdir/uv.tar.gz" | sha256sum -c \
 && tar -xzf "$uvdir/uv.tar.gz" --strip-components=1 -C "$uvdir" uv-aarch64-unknown-linux-gnu/uv \
 && "$uvdir/uv" venv /opt/frametop/venv \
 && cd /src/frametop && "$uvdir/uv" sync --frozen --group tracker --group voice --no-cache \
 && /opt/frametop/venv/bin/python -c 'import numpy, cv2, ncnn, sherpa_onnx, sentencepiece, huggingface_hub, cryptography, pytest' \
 && rm -rf "$uvdir"

WORKDIR /src/frametop
ENV FRAME_IN_BOX=1 OPENVR_LIB=/opt/frametop/lib
ENV PATH=/opt/frametop/venv/bin:/usr/local/bin:/usr/bin:/usr/sbin
CMD ["bash"]

# The sources, then the programs, built by the same build scripts as on the Frame
# (FRAME_IN_BOX=1: they run here, for the host). Each stays in its build/ folder: the tree at
# /src/frametop, built, is what a release ships (release.yml copies it out).
FROM runtime-common AS builder
COPY . /src/frametop
# Which commit this tree is, and whether the checkout had changes in (ft dev build's
# labels, as a file): framedrop/build.sh reads it from the tree copied out of the image.
ARG FT_BUILT="unknown unknown"
RUN echo "$FT_BUILT" > .ft-built
# The symbol-version pins were generated from a SteamOS beta's glibc; this image's must give
# the same, or a program could link a version the pins don't know.
RUN python3 scripts/glibc-compat.py --check
RUN screens/build.sh
RUN layout/countdown/build.sh
RUN pointer/helper/build.sh && pointer/driver/build.sh
RUN gaze/build.sh && gaze/tracker/build.sh
# Frametop's keyboard (TaiKeid's Full Keyboard): it stays in keyboard/build/frametop,
# with the input method engines, Steam bridge and SteamVR manifests it finds beside
# itself, where frametop-keyboard.service runs it from. The rest of the build goes.
RUN keyboard/build.sh \
 && cd keyboard/build/frametop \
 && find . -mindepth 1 -maxdepth 1 ! -name framekeyboard ! -name framekeyboard-native-guard \
      ! -name engines ! -name bridge ! -name vr -exec rm -rf {} + \
 && strip --strip-unneeded framekeyboard framekeyboard-native-guard engines/*.so
RUN power/build.sh
RUN stream/build.sh
# Frametop Voice: whisper.cpp's server (Vulkan). Its speech models aren't in the image:
# voice/models.sh fetches them on install.
RUN voice/build.sh
# Hand tracking: ft-camd (static: it runs with the file capabilities hands/run.sh install
# sets) and ft-hands, which builds ncnn from the source hands/Makefile pins (release zip,
# sha256). hands/models.sh fetches the pinned hand models into hands/models/student.
RUN hands/build.sh \
 && test -x hands/build/ft-camd && test -x hands/build/ft-hands
# The Hand Recorder's headset panel: it stays in hands/rec/build/, where the recorder
# (hands/rec/session.py) runs it from.
RUN hands/rec/build.sh \
 && test -x hands/rec/build/ft-handpanel
# What the builds leave beside their programs isn't shipped: the libraries' sources and
# objects (a developer's `ft dev shell` works on the mounted checkout, not this copy).
RUN rm -rf screens/build/wlroots stream/build/moonlight-embedded stream/build/mlc stream/build/gamestream \
      voice/build/whisper.cpp voice/build/spirv-headers hands/build/ncnn \
 && find . -path '*/build/*' -name '*.o' -delete

# The image CI and `ft dev` use: the toolchain and the test gate's Python, with the built
# tree. `ft dev test` mounts the checkout over /src/frametop, so it tests the checkout.
FROM runtime-common AS runtime
COPY --from=builder /src/frametop/ /src/frametop/
