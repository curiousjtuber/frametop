#!/bin/bash
# Launch the Frametop Hand Recorder from a Plasma session on the Frame host. The app runs in
# Frametop's Python runtime, a Flatpak (scripts/ft-python, pack/flatpak; PySide6, zstd and
# huggingface_hub are in it), as the package hands.rec of the tree; --gui hands it the
# session's Wayland socket and bus. Its host commands run from the home folder
# (recorder/common.py's host_command).
# Options go to ft_handrec.py: --base DIR, --page NAME, and --dry-run for testing.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
exec "$here/../../scripts/ft-python" --gui -m hands.rec.ft_handrec "$@"
