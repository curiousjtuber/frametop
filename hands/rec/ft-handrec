#!/bin/bash
# Launch the Frametop Hand Recorder from a Plasma session on the Frame host.
# The app runs on the host, with PySide6 from setup/pyside-venv.sh on the host's own Qt and
# Kirigami, like the settings apps. The session's Wayland socket and bus go to the app.
# Options go to ft_handrec.py: --base DIR, --page NAME, and --dry-run for testing.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
wl=${WAYLAND_DISPLAY:-wayland-0}
case $wl in /*) ;; *) wl="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$wl" ;; esac
session_bus=${DBUS_SESSION_BUS_ADDRESS:-}
py=$here/../../build/pyside/bin/frametop-python
[ -x "$py" ] || { echo "no $py: run setup/pyside-venv.sh" >&2; exit 1; }
exec env WAYLAND_DISPLAY="$wl" DBUS_SESSION_BUS_ADDRESS="$session_bus" QT_QPA_PLATFORM="wayland;xcb" \
  "$py" "$here/ft_handrec.py" "$@"
