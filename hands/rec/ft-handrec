#!/bin/bash
# Launch the Frametop Hand Recorder from a Plasma session on the Frame host. The app runs in
# Frametop's Python runtime, a Flatpak (scripts/ft-python, pack/flatpak; zstd and
# huggingface_hub are in it); --gui hands it the session's Wayland socket and bus.
# Options go to ft_handrec.py: --base DIR, --page NAME, and --dry-run for testing.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
cd "$HOME" || exit 1  # the app's host commands run in its folder
exec "$here/../../scripts/ft-python" --gui "$here/ft_handrec.py" "$@"
