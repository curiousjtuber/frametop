#!/usr/bin/env bash
# ft — Frametop's build environment, the image pack/Containerfile builds (pack/README.md).
#
# The image builds Frametop's programs for the SteamOS host, with the host's glibc version,
# and holds the test gate's Python; CI builds the release from it, and this wrapper gives a
# developer the same environment. Nothing runs from it on the headset.
#
# Usage, from a checkout (the commands mount it at /src/frametop):
#   ft dev build        build the image from the checkout (docker or podman)
#   ft dev shell        interactive shell in the image, the checkout mounted
#   ft dev test         the test gate inside the image (just test)
#   ft dev run CMD...   run a command inside the image, the checkout mounted
#
# FT_IMAGE names the image (default frametop:local); FT_ENGINE the container engine (default:
# podman if there is one, else docker).
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$root/pack/Containerfile" ] || { echo "ft: not in a Frametop checkout" >&2; exit 2; }
image=${FT_IMAGE:-frametop:local}
engine=${FT_ENGINE:-$(command -v podman || command -v docker || true)}
[ -n "$engine" ] || { echo "ft: need podman or docker on PATH" >&2; exit 1; }
# The checkout over the image's copy. The datagram queue length is the host's (512 from
# systemd): the input relay's tests send bursts that a container's default of 10 drops.
mounts=(-v "$root":/src/frametop --sysctl net.unix.max_dgram_qlen=512)

run_in_image() {
  local name
  name=frametop-$(printf '%s' "${1##*/}" | tr -c 'a-zA-Z0-9._-' '-')-$$
  exec "$engine" run --rm --name "$name" "${mounts[@]}" --workdir /src/frametop "$image" "$@"
}

case "${1:-help}" in
  dev)
    shift
    case "${1:-help}" in
      build) exec "$engine" build -f "$root/pack/Containerfile" -t "$image" "$root" ;;
      shell) exec "$engine" run --rm -it "${mounts[@]}" --workdir /src/frametop "$image" bash ;;
      test)  run_in_image just test ;;
      run)   shift; [ $# -gt 0 ] || { echo "ft dev run: no command" >&2; exit 2; }; run_in_image "$@" ;;
      help|-h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
      *) echo "ft dev: unknown command: $1 (build, shell, test, run)" >&2; exit 2 ;;
    esac ;;
  help|-h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) echo "ft: unknown command: $1 (ft dev build|shell|test|run)" >&2; exit 2 ;;
esac
