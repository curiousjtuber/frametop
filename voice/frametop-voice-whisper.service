# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop Voice: whisper.cpp on the GPU, for wake word commands and other languages
Documentation=file://@REPO@/voice/README.md
# ft-voiced starts it while something uses it (the wake word on), and stops it after; it also
# stops with ft-voiced's service. Not enabled on its own.
PartOf=frametop-voice.service

[Service]
ExecStartPre=-/usr/bin/pkill -x whisper-server
# Built for the host (voice/build.sh), so it runs directly. The Gamescope WSI layer asserts
# on compute-only Vulkan devices, and whisper needs no swapchain. voice/whisper-run picks the
# model the settings choose.
Environment=DISABLE_GAMESCOPE_WSI=1
Nice=5
ExecStart=@REPO@/voice/whisper-run --host 127.0.0.1 --port 8178 -t 3 -fa
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
