--- a/display-settings/ft-display-settings
+++ b/display-settings/ft-display-settings
@@ -1,17 +1,12 @@
 #!/bin/bash
 # Launch Frametop Display Settings from a Plasma session on the Frame host.
-# The app runs in the dev container (PySide6 and Kirigami come from Fedora there).
-# podman needs the real XDG_RUNTIME_DIR and the real user bus (to reach systemd for
-# the container's cgroup; the Frametop session runs on a private bus from
-# dbus-run-session). The session's Wayland socket and bus go to the app itself.
+# The app runs on the host, with PySide6 from setup/pyside-venv.sh on the host's own Qt
+# and Kirigami (README-host.md). The session's Wayland socket and bus go to the app.
 here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
 wl=${WAYLAND_DISPLAY:-wayland-0}
 case $wl in /*) ;; *) wl="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$wl" ;; esac
 session_bus=${DBUS_SESSION_BUS_ADDRESS:-}
-export XDG_RUNTIME_DIR=/run/user/$(id -u)
-export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
-"$here/../scripts/container-up.sh"
-exec "$HOME/.local/bin/distrobox" enter dev -- env WAYLAND_DISPLAY="$wl" DISPLAY="${DISPLAY:-}" \
-  XAUTHORITY="${XAUTHORITY:-}" DBUS_SESSION_BUS_ADDRESS="$session_bus" \
-  QT_QPA_PLATFORM="wayland;xcb" \
-  python3 "$here/ft_display_settings.py" "$@"
+py=$HOME/.local/share/frametop/pyside/bin/frametop-python
+[ -x "$py" ] || { echo "no $py: run setup/pyside-venv.sh" >&2; exit 1; }
+exec env WAYLAND_DISPLAY="$wl" DBUS_SESSION_BUS_ADDRESS="$session_bus" QT_QPA_PLATFORM="wayland;xcb" \
+  "$py" "$here/ft_display_settings.py" "$@"
