#!/bin/bash
# Launch Frametop Input Settings from a Plasma session on the Frame host. The app runs in
# Frametop's Python runtime, a Flatpak (scripts/ft-python, pack/flatpak); --gui hands it the
# session's Wayland socket and bus.
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
exec "$here/../scripts/ft-python" --gui "$here/ft_input_settings.py" "$@"
